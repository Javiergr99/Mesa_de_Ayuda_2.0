# auth_service: autenticación, refresh, /users/me y administración.
VITE_API_URL=http://127.0.0.1:8000
VITE_ADMIN_API_URL=http://127.0.0.1:8000
VITE_ENABLE_ADMIN_MOCKS=false

# API Mesa de Ayuda.
# En desarrollo se usa el proxy de Vite para evitar depender de CORS en el backend.
VITE_MESA_AYUDA_API_URL=/mesa-api
VITE_MESA_AYUDA_API_PROXY_TARGET=http://127.0.0.1:8001

# Frontend de autenticación universal.
VITE_AUTH_APP_URL=http://127.0.0.1:5174/login

# Entradas exactas autorizadas por auth_service:
# http://127.0.0.1:5173/app/dashboard
# http://127.0.0.1:5173/app/formato-nna
# http://127.0.0.1:5173/app/usuarios
# No usar localhost durante las pruebas locales.
