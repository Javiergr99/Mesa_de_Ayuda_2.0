# Servicio de autenticación. En producción debe usar HTTPS y cookies HttpOnly.
VITE_API_URL=http://127.0.0.1:8000

# Activa los repositorios simulados incluidos para demostración visual.
VITE_ENABLE_MOCKS=true

# Aplicaciones de destino después de seleccionar un acceso.
VITE_MESA_AYUDA_URL=http://127.0.0.1:5173/app/dashboard
VITE_ORGANIZADOR_URL=http://127.0.0.1:5173/app/organizador
VITE_MINERIA_URL=http://127.0.0.1:5173/app/mineria
VITE_ADMIN_URL=http://127.0.0.1:5173/app/usuarios

# Sitios públicos utilizados por el header institucional.
# Sustituye el valor por la URL pública real de Por Tus Derechos.
VITE_POR_TUS_DERECHOS_URL=/login
VITE_GOBMX_SEARCH_URL=https://www.gob.mx/busqueda
