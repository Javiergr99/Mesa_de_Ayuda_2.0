# API de autenticación. Usa el puerto donde realmente se ejecute FastAPI.
VITE_API_URL=http://127.0.0.1:8000

# true = servicios simulados; false = integración real con auth_service.
VITE_ENABLE_MOCKS=false

# Destinos mostrados después de interpretar usuario.permisos.grupos.
VITE_MESA_AYUDA_URL=http://127.0.0.1:5173/app/dashboard
VITE_FORMATO_NNA_URL=http://127.0.0.1:5173/app/formato-nna
VITE_ADMIN_URL=http://127.0.0.1:5173/app/usuarios

# Sitios públicos del encabezado institucional.
VITE_POR_TUS_DERECHOS_URL=/login
VITE_GOBMX_SEARCH_URL=https://www.gob.mx/busqueda

# IMPORTANTE: auth_service debe permitir exactamente estos tres valores.
# No usar localhost, query, hash ni una diagonal final adicional.
# Ejecuta `npm run redirects:validate` para validar e imprimir la lista blanca.
