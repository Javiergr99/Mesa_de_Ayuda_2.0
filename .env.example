# Mesa de Ayuda 2.0 - plantilla de variables
#
# Reglas:
# - No subir archivos .env reales al repositorio.
# - Las variables VITE_* son visibles en el navegador: nunca guardar secretos.
# - Las URLs base no deben terminar con slash (/).
# - localhost/127.0.0.1 se permiten únicamente en desarrollo.
# - Para el servidor 10.2.5.68 usar URLs alcanzables desde el navegador.

# auth_service
VITE_API_URL=

# API Mesa de Ayuda.
# En desarrollo puede usarse /mesa-api mediante el proxy de Vite.
# En producción debe ser una URL absoluta, por ejemplo http://IP:8000.
VITE_MESA_AYUDA_API_URL=

# Solo para proxy local/preview cuando se use /mesa-api.
VITE_MESA_AYUDA_API_PROXY_TARGET=

# Frontend Login Access.
VITE_AUTH_APP_URL=

# Interfaz pública del Formato NNA; puede quedar vacía hasta su despliegue.
VITE_FORMATO_NNA_PUBLIC_URL=

# Entradas SSO aceptadas actualmente por Mesa:
# /app/dashboard
# /app/formato-nna
